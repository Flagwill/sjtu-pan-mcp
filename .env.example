# 可选：复制为 .env 后按需修改。tbox-webdav.sh install/ensure 会自动生成 UID/GID。
# 这里只放非敏感的部署参数；WebDAV 密码和云盘 UserToken 放在 docker/config.yaml（0600）。

# 让容器以宿主机用户身份读取 0600 的 docker/config.yaml
# 请改成 `id -u` / `id -g` 的输出；install 会自动生成正确的 .env。
TBOX_UID=1000
TBOX_GID=1000

# 多实例部署时给每个实例不同的 compose 项目名和端口
COMPOSE_PROJECT_NAME=sjtu-pan-mcp

# 自定义镜像/版本（适合 fork 或私有 registry）
TBOX_IMAGE=sjtu-pan/mcp-tbox:1.0.4-tbox1.0.1
TBOX_VERSION=1.0.1
MCP_VERSION=1.0.4
